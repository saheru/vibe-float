<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CodexFloat</AssemblyName>
    <RootNamespace>CodexFloat</RootNamespace>
    <ApplicationIcon>Assets\CodexFloat.ico</ApplicationIcon>
    <Version>0.2.3</Version>
    <Authors>saheru</Authors>
    <Description>Floating Codex task, Sol effort, and usage dashboard for Windows.</Description>
  </PropertyGroup>
</Project>
