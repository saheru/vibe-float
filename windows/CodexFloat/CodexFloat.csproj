<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>VibeFloat</AssemblyName>
    <RootNamespace>CodexFloat</RootNamespace>
    <ApplicationIcon>Assets\CodexFloat.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <Version>0.5.3</Version>
    <Authors>saheru</Authors>
    <Description>Configurable floating Codex and Claude Code dashboard for Windows.</Description>
  </PropertyGroup>
</Project>
